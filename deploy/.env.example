# Copy to .env next to docker-compose.yml. Only the first two are required.

# Password for the bundled Postgres. Pick anything; it never leaves the stack.
POSTGRES_PASSWORD=change-me

# Salt for GDPR erasure tombstones. Pick a long random string and never
# change it afterwards: `openssl rand -hex 32` makes a good one.
ERASURE_SALT=change-me-too

# The address people will type into the browser. http://localhost:3000 for
# a laptop; https://hiring.example.com behind your reverse proxy.
PUBLIC_URL=http://localhost:3000
WEB_PORT=3000

# Which images to run. IMAGE_PREFIX is where they were published (a Docker
# Hub username, or ghcr.io/<user>); INTERVU_TAG applies to the API and the
# one-shot jobs; WEB_TAG is "latest" (no demo page) or "demo" (one-click
# demo sign-in).
IMAGE_PREFIX=sajucrajan
INTERVU_TAG=latest
WEB_TAG=latest

# ---- your organization (docker compose --profile setup run --rm bootstrap) ----
ORG_NAME=Globex Ltd
ORG_SLUG=globex
ADMIN_EMAIL=you@globex.example
ADMIN_NAME=Your Name
ADMIN_PASSWORD=at-least-ten-characters

# ---- optional ----
# Resumes: extract_only keeps the text and discards the file (no storage
# needed). Comment it out and fill the S3_* lines to keep the files.
RESUME_STORAGE=extract_only
#S3_ENDPOINT=https://s3.example.com
#S3_ACCESS_KEY=
#S3_SECRET_KEY=
#S3_BUCKET=intervu-files
#AWS_REGION=

# Outbound mail (agency release notices, scorecard reminders, invitations).
# Leave SMTP_HOST empty to log instead of sending.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#SMTP_SECURE=false
#SMTP_FROM=InterVU <no-reply@example.com>

# Sign-in page: auto (one organization → no field), picker, or manual.
LOGIN_ORG_MODE=auto
