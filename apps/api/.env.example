PORT=4000
DATABASE_URL=postgresql://intervu:intervu@localhost:5432/intervu
# Migrations only. Prisma takes an advisory lock, which a transaction
# pooler cannot hold across statements — so migrate needs the direct
# endpoint. Locally there is no pooler, so it is the same URL.
DIRECT_DATABASE_URL=postgresql://intervu:intervu@localhost:5432/intervu
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=intervu
S3_SECRET_KEY=intervu-dev-secret
S3_BUCKET=intervu-files
# Mail (vendor release notifications). Unset SMTP_HOST = log-only mode.
# Dev: docker compose -f infra/docker-compose.yml up -d mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="InterVU <no-reply@intervu.local>"
# SMTP_USER= / SMTP_PASS= / SMTP_SECURE=true for real providers
WEB_ORIGIN=http://localhost:3000
# How the sign-in page asks for the organization (docs/05 §1):
#   auto (default) = single-org deployments resolve it automatically;
#   picker = dropdown (publishes your organization list); manual = always typed
LOGIN_ORG_MODE=auto
# Salt for GDPR erasure identity tombstones — set a stable secret in production
# ERASURE_SALT=change-me
