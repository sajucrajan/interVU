// InterVU — M0 core schema.
// Naming: camelCase in Prisma, snake_case in Postgres via @map/@@map.
// Design authority: docs/03-data-model.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Tenancy: organization & hierarchy ----------

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  // ownership_window_days, ownership_scope, feedback policy, coarse status map…
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orgUnits     OrgUnit[]
  orgUsers     OrgUser[]
  vendorOrgs   VendorOrg[]
  positions    Position[]
  candidates   Candidate[]
  auditLogs    AuditLog[]
  inviteTokens InviteToken[]
  roles        Role[]
  slaPolicies  SlaPolicy[]

  @@map("organization")
}

enum OrgUnitKind {
  unit
  team

  @@map("org_unit_kind")
}

/// Self-referential tree: verticals/units contain units or teams, any depth.
/// Positions attach to `team` nodes only; parent must belong to the same
/// organization (application-enforced, see OrgUnitsService).
model OrgUnit {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  parentId       String?     @map("parent_id") @db.Uuid
  name           String
  kind           OrgUnitKind
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id])
  parent       OrgUnit?        @relation("OrgUnitTree", fields: [parentId], references: [id])
  children     OrgUnit[]       @relation("OrgUnitTree")
  positions    Position[]
  memberships  OrgMembership[]
  panels       Panel[]
  templates    PositionTemplate[]

  @@unique([organizationId, parentId, name])
  @@index([organizationId, parentId])
  @@map("org_unit")
}

// ---------- Org users & memberships ----------

/// An organization-defined bundle of permissions.
///
/// Enforcement is always on permissions, never on role names (docs/09 §2), so
/// an organization can name authority the way it actually does — "Release
/// Train Engineer", "Program Manager", "Managing Director" — without a code
/// change or a migration. The five built-ins ship as `isSystem` rows.
model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Stable slug; system roles keep their historical keys (org_admin, …).
  key            String
  name           String
  description    String?
  permissions    String[]
  /// Built-ins can be re-permissioned but never deleted.
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id])
  memberships  OrgMembership[]

  @@unique([organizationId, key])
  @@map("role")
}

enum UserStatus {
  invited
  active
  disabled

  @@map("user_status")
}

model OrgUser {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  email          String
  name           String
  passwordHash   String?    @map("password_hash")
  status         UserStatus @default(invited)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id])
  memberships  OrgMembership[]
  sessions     Session[]
  panelistOn   InterviewPanelist[]
  scorecards   Scorecard[]
  panelMemberships PanelMember[]
  inviteTokens InviteToken[]

  @@unique([organizationId, email])
  @@map("org_user")
}

/// orgUnitId null = org-wide. A unit-scoped membership applies to the node
/// and all descendants (vertical-level hiring_manager covers child teams).
model OrgMembership {
  id        String   @id @default(uuid()) @db.Uuid
  orgUserId String   @map("org_user_id") @db.Uuid
  orgUnitId String?  @map("org_unit_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  orgUser OrgUser  @relation(fields: [orgUserId], references: [id])
  orgUnit OrgUnit? @relation(fields: [orgUnitId], references: [id])
  role    Role     @relation(fields: [roleId], references: [id])

  // Postgres treats NULLs as distinct, so this does NOT stop a duplicate
  // org-wide grant (org_unit_id IS NULL) — the service checks explicitly.
  @@unique([orgUserId, orgUnitId, roleId])
  @@index([roleId])
  @@map("org_membership")
}

// ---------- Vendors ----------

enum VendorStatus {
  invited
  active
  suspended
  terminated

  @@map("vendor_status")
}

enum VendorRole {
  vendor_admin
  vendor_recruiter

  @@map("vendor_role")
}

model Vendor {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  vendorOrgs  VendorOrg[]
  vendorUsers VendorUser[]

  @@map("vendor")
}

/// The org↔vendor contract. Tier drives tiered release (1 = most preferred).
model VendorOrg {
  id             String       @id @default(uuid()) @db.Uuid
  vendorId       String       @map("vendor_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  tier           Int          @default(1)
  status         VendorStatus @default(invited)
  contractStart  DateTime?    @map("contract_start")
  contractEnd    DateTime?    @map("contract_end")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  vendor       Vendor                  @relation(fields: [vendorId], references: [id])
  organization Organization            @relation(fields: [organizationId], references: [id])
  releases     PositionVendorRelease[]
  submissions  Submission[]

  @@unique([vendorId, organizationId])
  @@map("vendor_org")
}

model VendorUser {
  id           String     @id @default(uuid()) @db.Uuid
  vendorId     String     @map("vendor_id") @db.Uuid
  email        String
  name         String
  passwordHash String?    @map("password_hash")
  role         VendorRole @default(vendor_recruiter)
  status       UserStatus @default(invited)
  createdAt    DateTime   @default(now()) @map("created_at")

  vendor       Vendor        @relation(fields: [vendorId], references: [id])
  sessions     Session[]
  submissions  Submission[]
  inviteTokens InviteToken[]

  @@unique([vendorId, email])
  @@map("vendor_user")
}

/// How long a piece of work may sit before it is late.
///
/// One row per (organization, event). `sla_state` is derived, never stored:
/// ok below 70% of the threshold, aging above it, breached past it — so
/// changing a threshold re-colours history immediately instead of leaving
/// stale states behind.
model SlaPolicy {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// first_screen | scorecard_due | decision_due | vendor_ack
  event          String
  thresholdHours Int      @map("threshold_hours")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, event])
  @@map("sla_policy")
}

/// A single-use activation link for a user who has no password yet.
///
/// Only the SHA-256 hash of the token is stored — the same discipline as
/// `Session` — so a leaked database row cannot be replayed against the
/// activation endpoint. Exactly one of orgUserId/vendorUserId is set.
///
/// The token travels by email only, never through the org-wide Slack/Teams
/// channels: those have a wider audience than the invitee.
model InviteToken {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  orgUserId      String?   @map("org_user_id") @db.Uuid
  vendorUserId   String?   @map("vendor_user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  orgUser      OrgUser?     @relation(fields: [orgUserId], references: [id])
  vendorUser   VendorUser?  @relation(fields: [vendorUserId], references: [id])

  @@index([orgUserId])
  @@index([vendorUserId])
  @@map("invite_token")
}

/// Server-side sessions. Only the SHA-256 hash of the bearer token is stored;
/// exactly one of orgUserId/vendorUserId is set.
model Session {
  id           String   @id @default(uuid()) @db.Uuid
  tokenHash    String   @unique @map("token_hash")
  orgUserId    String?  @map("org_user_id") @db.Uuid
  vendorUserId String?  @map("vendor_user_id") @db.Uuid
  /// Which organization this session is scoped to. Vendor sessions are
  /// ALWAYS org-scoped: a vendor serving several orgs logs in per org and
  /// never sees two orgs' data in one session. Org sessions derive it from
  /// the user, and store it here for symmetry.
  organizationId String? @map("organization_id") @db.Uuid
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  orgUser    OrgUser?    @relation(fields: [orgUserId], references: [id], onDelete: Cascade)
  vendorUser VendorUser? @relation(fields: [vendorUserId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("session")
}

// ---------- Positions & release ----------

enum PositionStatus {
  draft
  open
  paused
  closed

  @@map("position_status")
}

enum Seniority {
  junior
  mid
  senior
  staff
  principal

  @@map("seniority")
}

enum EmploymentType {
  full_time
  contract
  contract_to_hire

  @@map("employment_type")
}

enum LocationPolicy {
  onsite
  hybrid
  remote

  @@map("location_policy")
}

enum RatePeriod {
  hourly
  daily
  monthly
  annual

  @@map("rate_period")
}

enum ReleaseMode {
  all_at_once
  tiered
  manual

  @@map("release_mode")
}

enum ReleaseSource {
  policy
  manual

  @@map("release_source")
}

model Position {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  orgUnitId      String         @map("org_unit_id") @db.Uuid
  /// Human-readable identifier (POS-001) — what people actually quote in
  /// conversation, emails and vendor threads. Unique per organization.
  reference      String
  title          String
  description    String         @default("")
  openings       Int            @default(1)
  status         PositionStatus @default(draft)
  // Role identity (docs/01 — job posting design)
  seniority      Seniority?
  employmentType EmploymentType @default(full_time) @map("employment_type")
  locationPolicy LocationPolicy? @map("location_policy")
  locationText   String?        @map("location_text")
  minTotalYears  Int?           @map("min_total_years")
  // Vendor-facing rate band
  rateMin        Int?           @map("rate_min")
  rateMax        Int?           @map("rate_max")
  rateCurrency   String         @default("USD") @map("rate_currency")
  ratePeriod     RatePeriod?    @map("rate_period")
  // Non-skill screening requirements (certs, visa, languages, …)
  mustHaves      Json           @default("[]") @map("must_haves")
  publishedAt    DateTime?      @map("published_at")
  createdById    String?        @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization  Organization            @relation(fields: [organizationId], references: [id])
  orgUnit       OrgUnit                 @relation(fields: [orgUnitId], references: [id])
  releasePolicy ReleasePolicy?
  releases      PositionVendorRelease[]
  submissions   Submission[]
  applications  Application[]
  skills        PositionSkill[]

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@map("position")
}

model ReleasePolicy {
  id         String      @id @default(uuid()) @db.Uuid
  positionId String      @unique @map("position_id") @db.Uuid
  mode       ReleaseMode
  // tiered: {"steps": [{"tier": 1, "delay_hours": 0}, ...]}
  config     Json        @default("{}")
  createdAt  DateTime    @default(now()) @map("created_at")

  position Position @relation(fields: [positionId], references: [id])

  @@map("release_policy")
}

/// The visibility gate. A vendor sees a position iff:
///   position.status = 'open' AND now() >= visible_from
///   AND vendor_org.status = 'active'
/// DB is truth; workers only notify (docs/05 §2).
model PositionVendorRelease {
  id           String        @id @default(uuid()) @db.Uuid
  positionId   String        @map("position_id") @db.Uuid
  vendorOrgId  String        @map("vendor_org_id") @db.Uuid
  visibleFrom  DateTime      @map("visible_from")
  source       ReleaseSource @default(policy)
  releasedById String?       @map("released_by_id") @db.Uuid
  /// Set when the vendor was emailed about this release — the idempotency
  /// marker for the notifier sweep (docs/05 §5). DB is truth; no queue needed.
  notifiedAt   DateTime?     @map("notified_at")
  createdAt    DateTime      @default(now()) @map("created_at")

  position  Position  @relation(fields: [positionId], references: [id])
  vendorOrg VendorOrg @relation(fields: [vendorOrgId], references: [id])

  @@unique([positionId, vendorOrgId])
  @@index([vendorOrgId, visibleFrom])
  @@map("position_vendor_release")
}

// ---------- Candidates, submissions, matching (docs/03, docs/04) ----------

enum IdentityKind {
  email
  phone
  phone_last10
  linkedin
  /// Salted HMAC of an erased identifier — matchable for "an erased record
  /// existed" without retaining the PII itself (docs/04 §7).
  tombstone

  @@map("identity_kind")
}

enum SubmissionStatus {
  received
  accepted
  pending_review
  duplicate
  rejected
  withdrawn

  @@map("submission_status")
}

enum OwnershipStatus {
  owner
  duplicate
  arbitrated_owner
  not_applicable

  @@map("ownership_status")
}

enum ApplicationStatus {
  active
  hired
  rejected
  withdrawn

  @@map("application_status")
}

enum MatchOutcome {
  auto_linked
  auto_new
  reviewed_linked
  reviewed_new

  @@map("match_outcome")
}

/// The golden record: a candidate is NOT a submission (docs/03 §1).
/// merged_into_id set = this record was merged into another master; it is
/// kept (empty) so merges are reversible, and excluded from matching/lists.
model Candidate {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  /// Human-readable master id people quote in conversation (CM-0428), the
  /// same idea as Position.reference. Assigned per organization.
  reference       String?
  displayName     String    @map("display_name")
  currentTitle    String?   @map("current_title")
  currentEmployer String?   @map("current_employer")
  location        String?
  mergedIntoId    String?   @map("merged_into_id") @db.Uuid
  /// GDPR erasure (docs/04 §7): PII nulled, identities replaced by salted
  /// HMAC tombstones. The record survives so ownership/audit history stays
  /// intact; matching never links to an erased record.
  erasedAt        DateTime? @map("erased_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id])
  identities   CandidateIdentity[]
  submissions  Submission[]
  applications Application[]
  flags        CandidateFlag[]

  @@unique([organizationId, reference])
  @@index([organizationId])
  @@map("candidate")
}

/// Known identifiers; identities accrete over time so the same person via a
/// second vendor/email eventually matches deterministically (docs/04 §2.2).
model CandidateIdentity {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  candidateId        String       @map("candidate_id") @db.Uuid
  kind               IdentityKind
  valueNorm          String       @map("value_norm")
  valueRaw           String       @map("value_raw")
  sourceSubmissionId String?      @map("source_submission_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind, valueNorm])
  @@map("candidate_identity")
}

/// One vendor putting one candidate forward for one position at one time.
/// received_at (server clock) is the ownership tie-breaker (docs/05 §3).
model Submission {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  positionId       String           @map("position_id") @db.Uuid
  vendorOrgId      String           @map("vendor_org_id") @db.Uuid
  vendorUserId     String           @map("vendor_user_id") @db.Uuid
  candidateId      String?          @map("candidate_id") @db.Uuid
  rawProfile       Json             @map("raw_profile")
  status           SubmissionStatus @default(received)
  ownershipStatus  OwnershipStatus  @default(not_applicable) @map("ownership_status")
  consentConfirmed Boolean          @default(false) @map("consent_confirmed")
  expectedRate     String?          @map("expected_rate")
  vendorNotes      String?          @map("vendor_notes")
  receivedAt       DateTime         @default(now()) @map("received_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  position      Position       @relation(fields: [positionId], references: [id])
  vendorOrg     VendorOrg      @relation(fields: [vendorOrgId], references: [id])
  vendorUser    VendorUser     @relation(fields: [vendorUserId], references: [id])
  candidate     Candidate?        @relation(fields: [candidateId], references: [id])
  matchDecision MatchDecision?
  reviewItems   MatchReviewItem[]

  @@index([organizationId, positionId])
  @@index([organizationId, candidateId, receivedAt])
  @@map("submission")
}

/// The org's pipeline instance — one per (position, candidate) regardless of
/// how many submissions arrive (docs/03 §1).
model Application {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  positionId         String            @map("position_id") @db.Uuid
  candidateId        String            @map("candidate_id") @db.Uuid
  sourceSubmissionId String            @map("source_submission_id") @db.Uuid
  currentStage       String            @default("submitted") @map("current_stage")
  status             ApplicationStatus @default(active)
  /// The candidate left the process rather than being rejected — withdrew,
  /// went unresponsive, or declined an offer. `dropoutAtStage` records where,
  /// because a dropout at offer means something different from one at screening.
  dropoutKind        DropoutKind?      @map("dropout_kind")
  dropoutAtStage     String?           @map("dropout_at_stage")
  dropoutAt          DateTime?         @map("dropout_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  position         Position          @relation(fields: [positionId], references: [id])
  candidate        Candidate         @relation(fields: [candidateId], references: [id])
  interviews       Interview[]
  stageTransitions StageTransition[]
  decision         Decision?
  debrief          Debrief?
  offer            Offer?

  @@unique([positionId, candidateId])
  @@index([organizationId, status])
  @@map("application")
}

/// Admin-only master merges — always human, always reversible (docs/04 §3).
/// snapshot records exactly which child rows moved so reverse() restores them.
model MergeEvent {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  survivingCandidateId String    @map("surviving_candidate_id") @db.Uuid
  mergedCandidateId    String    @map("merged_candidate_id") @db.Uuid
  performedById        String?   @map("performed_by_id") @db.Uuid
  snapshot             Json
  reversedAt           DateTime? @map("reversed_at")
  reversedById         String?   @map("reversed_by_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("merge_event")
}

enum ReviewStatus {
  open
  linked
  kept_separate

  @@map("review_status")
}

/// Human-in-the-loop queue for review-band fuzzy matches (docs/04 §3).
/// kept_separate items are remembered as negative examples so the engine
/// stops re-asking about the same pair.
model MatchReviewItem {
  id                   String       @id @default(uuid()) @db.Uuid
  organizationId       String       @map("organization_id") @db.Uuid
  submissionId         String       @map("submission_id") @db.Uuid
  candidateIdSuggested String       @map("candidate_id_suggested") @db.Uuid
  score                Float
  featureBreakdown     Json         @map("feature_breakdown")
  status               ReviewStatus @default(open)
  resolvedById         String?      @map("resolved_by_id") @db.Uuid
  resolvedAt           DateTime?    @map("resolved_at")
  createdAt            DateTime     @default(now()) @map("created_at")

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("match_review_item")
}

/// Why a submission linked (or didn't) — explainability (docs/04 §1.2).
model MatchDecision {
  id               String       @id @default(uuid()) @db.Uuid
  submissionId     String       @unique @map("submission_id") @db.Uuid
  candidateId      String?      @map("candidate_id") @db.Uuid
  outcome          MatchOutcome
  score            Float
  featureBreakdown Json         @map("feature_breakdown")
  decidedById      String?      @map("decided_by_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("match_decision")
}

// ---------- Interviews, feedback, decisions, flags (docs/03 §2, M2) ----------

enum InterviewStatus {
  scheduled
  completed
  canceled
  no_show

  @@map("interview_status")
}

enum Recommendation {
  strong_yes
  yes
  no
  strong_no

  @@map("recommendation")
}

enum DecisionOutcome {
  offer
  reject
  hold

  @@map("decision_outcome")
}

enum FlagKind {
  do_not_hire
  caution
  note

  @@map("flag_kind")
}

model Interview {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  applicationId  String          @map("application_id") @db.Uuid
  roundName      String          @map("round_name")
  scheduledAt    DateTime        @map("scheduled_at")
  durationMin    Int             @default(60) @map("duration_min")
  locationOrLink String?         @map("location_or_link")
  status         InterviewStatus @default(scheduled)
  createdById    String?         @map("created_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")

  application Application          @relation(fields: [applicationId], references: [id])
  panelists   InterviewPanelist[]
  scorecards  Scorecard[]

  @@index([organizationId, scheduledAt])
  @@map("interview")
}

model InterviewPanelist {
  id          String @id @default(uuid()) @db.Uuid
  interviewId String @map("interview_id") @db.Uuid
  orgUserId   String @map("org_user_id") @db.Uuid
  role        String @default("interviewer")

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  orgUser   OrgUser   @relation(fields: [orgUserId], references: [id])

  @@unique([interviewId, orgUserId])
  @@map("interview_panelist")
}

/// One panelist's structured feedback. Visibility of others' scorecards is
/// governed by the org feedback policy (docs/01 §2.3) in the service layer.
model Scorecard {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  interviewId    String         @map("interview_id") @db.Uuid
  orgUserId      String         @map("org_user_id") @db.Uuid
  overallRating  Int            @map("overall_rating") // 1..5
  recommendation Recommendation
  notes          String         @default("")
  submittedAt    DateTime       @default(now()) @map("submitted_at")

  interview    Interview             @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  orgUser      OrgUser               @relation(fields: [orgUserId], references: [id])
  competencies ScorecardCompetency[]

  @@unique([interviewId, orgUserId])
  @@map("scorecard")
}

model StageTransition {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  applicationId  String   @map("application_id") @db.Uuid
  fromStage      String   @map("from_stage")
  toStage        String   @map("to_stage")
  byId           String?  @map("by_id") @db.Uuid
  note           String?
  at             DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id])

  @@index([applicationId, at])
  @@map("stage_transition")
}

model Decision {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  applicationId  String          @unique @map("application_id") @db.Uuid
  outcome        DecisionOutcome
  reason         String          @default("")
  decidedById    String?         @map("decided_by_id") @db.Uuid
  decidedAt      DateTime        @default(now()) @map("decided_at")

  application Application @relation(fields: [applicationId], references: [id])

  @@map("decision")
}

/// History exists largely so teams don't re-interview someone rejected for
/// cause (docs/01 §2.4). Flags surface as warnings everywhere (docs/09 §4.3).
model CandidateFlag {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  candidateId    String    @map("candidate_id") @db.Uuid
  kind           FlagKind
  reason         String
  createdById    String?   @map("created_by_id") @db.Uuid
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_flag")
}

// ---------- Skills & interview panels (docs/01, docs/03) ----------

enum RequirementLevel {
  must_have
  good_to_have

  @@map("requirement_level")
}

/// Org-scoped skill taxonomy (Kubernetes, Spark, System Design, …).
model Skill {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  nameNorm       String   @map("name_norm")
  createdAt      DateTime @default(now()) @map("created_at")

  positionSkills PositionSkill[]
  panelSkills    PanelSkill[]
  templateSkills PositionTemplateSkill[]
  scorecardRatings ScorecardCompetency[]

  @@unique([organizationId, nameNorm])
  @@map("skill")
}

enum Proficiency {
  awareness
  working
  proficient
  expert

  @@map("proficiency")
}

/// Importance (must/good) and required proficiency are separate axes:
/// "must have Kubernetes at working level" ≠ "nice to have K8s at expert".
model PositionSkill {
  id          String           @id @default(uuid()) @db.Uuid
  positionId  String           @map("position_id") @db.Uuid
  skillId     String           @map("skill_id") @db.Uuid
  level       RequirementLevel
  proficiency Proficiency      @default(working)
  minYears    Int?             @map("min_years")

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId], references: [id])

  @@unique([positionId, skillId])
  @@map("position_skill")
}

/// A reusable job description. Recruiters start a position from a template
/// and adjust only what differs, instead of re-entering a standard JD each
/// time. Templates can be authored directly or captured from a live position.
model PositionTemplate {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  /// What the template is called in the picker ("Backend Engineer — standard").
  name           String
  summary        String          @default("")
  // ---- Defaults copied onto a new position ----
  title          String
  description    String          @default("")
  seniority      Seniority?
  employmentType EmploymentType  @default(full_time) @map("employment_type")
  locationPolicy LocationPolicy? @map("location_policy")
  locationText   String?         @map("location_text")
  minTotalYears  Int?            @map("min_total_years")
  openings       Int             @default(1)
  rateMin        Int?            @map("rate_min")
  rateMax        Int?            @map("rate_max")
  rateCurrency   String          @default("USD") @map("rate_currency")
  ratePeriod     RatePeriod?     @map("rate_period")
  mustHaves      Json            @default("[]") @map("must_haves")
  /// Optional default team; the recruiter can always pick another.
  orgUnitId      String?         @map("org_unit_id") @db.Uuid
  createdById    String?         @map("created_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  orgUnit OrgUnit?                @relation(fields: [orgUnitId], references: [id])
  skills  PositionTemplateSkill[]

  @@unique([organizationId, name])
  @@map("position_template")
}

model PositionTemplateSkill {
  id          String           @id @default(uuid()) @db.Uuid
  templateId  String           @map("template_id") @db.Uuid
  skillId     String           @map("skill_id") @db.Uuid
  level       RequirementLevel
  proficiency Proficiency      @default(working)
  minYears    Int?             @map("min_years")

  template PositionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  skill    Skill            @relation(fields: [skillId], references: [id])

  @@unique([templateId, skillId])
  @@map("position_template_skill")
}

/// A named pool of panelists for a technology/knowledge area. Scope follows
/// the org-unit pattern: null = org-wide; a unit/vertical or team node covers
/// that node and all descendants (same semantics as memberships, docs/09 §3).
model Panel {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  orgUnitId      String?  @map("org_unit_id") @db.Uuid
  name           String
  description    String   @default("")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  orgUnit OrgUnit?      @relation(fields: [orgUnitId], references: [id])
  skills  PanelSkill[]
  members PanelMember[]

  @@unique([organizationId, name])
  @@map("panel")
}

model PanelSkill {
  id      String @id @default(uuid()) @db.Uuid
  panelId String @map("panel_id") @db.Uuid
  skillId String @map("skill_id") @db.Uuid

  panel Panel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id])

  @@unique([panelId, skillId])
  @@map("panel_skill")
}

model PanelMember {
  id        String @id @default(uuid()) @db.Uuid
  panelId   String @map("panel_id") @db.Uuid
  orgUserId String @map("org_user_id") @db.Uuid

  panel   Panel   @relation(fields: [panelId], references: [id], onDelete: Cascade)
  orgUser OrgUser @relation(fields: [orgUserId], references: [id])

  @@unique([panelId, orgUserId])
  @@map("panel_member")
}

// ---------- Files (docs/03 §2: attachments) ----------

/// Resume/document storage metadata; bytes live in S3-compatible storage.
/// parsed_text feeds the matching engine's resume features (docs/04, M4).
model Attachment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  kind           String   @default("resume")
  ownerType      String   @map("owner_type") // submission | candidate
  ownerId        String   @map("owner_id") @db.Uuid
  s3Key          String   @map("s3_key")
  filename       String
  contentType    String   @map("content_type")
  size           Int
  parsedText     String?  @map("parsed_text")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([ownerType, ownerId])
  @@map("attachment")
}

// ---------- Notifications: generic org webhooks (docs/06 §4) ----------

/// Org-registered endpoint receiving HMAC-signed JSON for selected events.
/// The generic integration path — Slack/Teams/email are built-in channels,
/// this is for everything else.
model WebhookEndpoint {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  url            String
  secret         String
  events         String[] @default([])
  active         Boolean  @default(true)
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("webhook_endpoint")
}

enum DeliveryChannel {
  email
  slack
  teams
  webhook

  @@map("delivery_channel")
}

enum DeliveryStatus {
  pending
  delivered
  dead

  @@map("delivery_status")
}

/// Durable outbound notifications (docs/05 §5): every send is a row, a
/// worker attempts it with exponential backoff, failures stay visible, and
/// dead letters can be retried. A temporarily-down channel delays a message,
/// never loses it.
model NotificationDelivery {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  channel        DeliveryChannel
  endpointId     String?         @map("endpoint_id") @db.Uuid
  target         String
  event          String
  body           Json
  status         DeliveryStatus  @default(pending)
  attempts       Int             @default(0)
  nextAttemptAt  DateTime        @default(now()) @map("next_attempt_at")
  lastError      String?         @map("last_error")
  deliveredAt    DateTime?       @map("delivered_at")
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([status, nextAttemptAt])
  @@index([organizationId, createdAt])
  @@map("notification_delivery")
}

// ---------- Audit ----------

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorType      String   @map("actor_type") // org_user | vendor_user | system
  actorId        String?  @map("actor_id") @db.Uuid
  event          String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id") @db.Uuid
  payload        Json     @default("{}")
  requestId      String?  @map("request_id")
  at             DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, entityType, entityId])
  @@map("audit_log")
}

// ---------- Panel debrief & vendor feedback (docs/05 §7) ----------

/// One panelist's rating of ONE competency, so a loop resolves into a matrix
/// rather than four unrelated numbers. Rows follow the position's skill matrix
/// (PositionSkill), which is what stops the debrief and the JD drifting apart.
model ScorecardCompetency {
  id          String   @id @default(uuid()) @db.Uuid
  scorecardId String   @map("scorecard_id") @db.Uuid
  skillId     String   @map("skill_id") @db.Uuid
  /// 1..5, or null for "not assessed in my round".
  rating      Int?
  createdAt   DateTime @default(now()) @map("created_at")

  scorecard Scorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id])

  @@unique([scorecardId, skillId])
  @@map("scorecard_competency")
}

enum DebriefStatus {
  open
  resolved

  @@map("debrief_status")
}

/// Where a loop resolves into one verdict. Panel mean, divergence and the
/// consensus row are DERIVED from the scorecards at query time, never stored,
/// so re-opening a scorecard cannot leave a stale summary behind.
model Debrief {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  applicationId  String        @unique @map("application_id") @db.Uuid
  status         DebriefStatus @default(open)
  /// Never leaves the organization.
  internalReason String        @default("") @map("internal_reason")
  resolvedById   String?       @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime?     @map("resolved_at")
  /// Releasing is a separate, audited event from deciding — a legal or HR
  /// review may sit between the two.
  releasedById   String?       @map("released_by_id") @db.Uuid
  releasedAt     DateTime?     @map("released_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  application Application     @relation(fields: [applicationId], references: [id])
  packet      FeedbackPacket?

  @@index([organizationId, status])
  @@map("debrief")
}

enum FeedbackVisibility {
  vendor
  candidate
  none

  @@map("feedback_visibility")
}

/// What actually leaves the building.
///
/// Redaction is a SCHEMA property here, not a UI convention: there is
/// deliberately no foreign key to scorecard, interview or org_user, and no
/// numeric rating anywhere. The vendor-facing serializer has nothing to
/// redact because the row never held it. Strengths and gaps name competencies,
/// never scores.
model FeedbackPacket {
  id         String             @id @default(uuid()) @db.Uuid
  debriefId  String             @unique @map("debrief_id") @db.Uuid
  visibility FeedbackVisibility @default(none)
  /// Outcome label shown externally ("Not selected"), not the internal enum.
  headline   String             @default("")
  summary    String             @default("")
  strengths  String[]
  gaps       String[]
  /// "Would consider for…" — the highest-value field for a vendor, because it
  /// tells them what to send next.
  reconsiderFor String?         @map("reconsider_for")
  /// Feeds the duplicate engine: a resubmission after this date for a
  /// different role is not flagged as a duplicate.
  resubmitAfter DateTime?       @map("resubmit_after")
  /// Auto-drafted text stays a draft until a human edits or confirms it; an
  /// unreviewed draft can never be released.
  isDraft        Boolean        @default(true) @map("is_draft")
  acknowledgedAt DateTime?      @map("acknowledged_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  debrief Debrief @relation(fields: [debriefId], references: [id], onDelete: Cascade)

  @@map("feedback_packet")
}

// ---------- Offers & dropout (docs/05 §7, handoff items #16 / #7) ----------

enum RateBandFit {
  below
  in
  above

  @@map("rate_band_fit")
}

enum DeclineReason {
  compensation
  counter_offer
  competing_offer
  role_scope
  location
  timing
  other

  @@map("decline_reason")
}

/// An offer extended for an application, and what became of it.
///
/// Separate from Decision because an offer has its own life after the
/// decision is recorded: it is extended, then accepted or declined, often
/// days later. Acceptance is what makes "time to hire" and "offer accept
/// rate" real rather than estimated.
model Offer {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  applicationId  String        @unique @map("application_id") @db.Uuid
  amount         Decimal?      @db.Decimal(12, 2)
  currency       String        @default("EUR")
  /// Where the offer sits against the position's advertised band — drives the
  /// "above band" flag on the pipeline card.
  vsRateBand     RateBandFit?  @map("vs_rate_band")
  extendedAt     DateTime      @default(now()) @map("extended_at")
  acceptedAt     DateTime?     @map("accepted_at")
  declinedAt     DateTime?     @map("declined_at")
  declinedReason DeclineReason? @map("declined_reason")
  declinedNote   String        @default("") @map("declined_note")
  createdById    String?       @map("created_by_id") @db.Uuid
  updatedAt      DateTime      @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id])

  @@index([organizationId, acceptedAt])
  @@map("offer")
}

enum DropoutKind {
  withdrew
  unresponsive
  declined_offer

  @@map("dropout_kind")
}
